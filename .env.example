# Copiar a .env y completar las claves. docker compose y la aplicación leen el mismo archivo.

PG_HOST=127.0.0.1
PG_PORT=5432
PG_DB=logistica
PG_USER=logistica
PG_PASSWORD=cambiar_clave_pg

MONGO_HOST=127.0.0.1
MONGO_PORT=27018
MONGO_DB=logistica
MONGO_REPLICA_SET=rs0

NEO4J_HOST=127.0.0.1
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
