NEO4J_PASSWORD=cambiar_clave_neo4j

REDIS_HOST=127.0.0.1
REDIS_PORT=6379

MARGEN_FACTURACION=0.25
SESION_TTL_SEGUNDOS=1800
HEARTBEAT_TTL_SEGUNDOS=900
UMBRAL_BATERIA=15
MINUTOS_GRACIA_SENSOR=15

LOG_ARCHIVO=logistica.log
DIRECTORIO_SALIDAS=salidas
